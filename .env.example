# Secrets and per-machine values only. Everything else lives in copilot.yaml.
# COPILOT_CONFIG=copilot.yaml

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

COPILOT_POSTGRES_URL=postgresql://copilot:copilot@localhost:5432/copilot

# Only if your Loki needs basic auth:
# COPILOT_INTEGRATIONS__LOGS__LOKI__PASSWORD=

# Read-only token for the code integration. Without it GitHub allows 60 requests an hour.
# Fine-grained token with Contents: read and Metadata: read on the service repos is enough.
GITHUB_TOKEN=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CHAOS_ADMIN_TOKEN=change-me
