// Ships stdout logs of demo containers to Loki.
// Only containers labelled incident.copilot.logs=true are collected, and each stream gets a
// `service` label taken from its Docker Compose service name. The copilot's logs integration
// selects streams by that label (integrations.logs.service_label in copilot.yaml).

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "demo" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_incident_copilot_logs"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "demo" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.demo.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
